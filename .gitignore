*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
captures/
.externalNativeBuild
.cxx
local.properties
*.hprof

# Tool caches (Kotlin compiler sessions, SonarQube scanner, skill caches, Claude Code local state)
.kotlin/
.scannerwork/
.cache/
.claude/

# Signing material — never commit (release keystore lives offline per the ADR #10 runbook)
*.jks
*.keystore
*.p12
keystore.properties

# Firebase config — local-only; required on disk for the google-services plugin, never committed
google-services.json

# Firebase CLI / emulator run logs
*-debug.log

# Node workspaces (functions/, rules-test/) — dependencies are local (npm install), never committed
node_modules/
.firebase/

# Firebase Auth credential stores from the pairing rig (test accounts) — never committed
.tmp-auth-backup/
.tmp-auth-rig-snapshot/

# Environment files (Firebase Functions supports functions/.env) — local only
.env
.env.*
!.env.example

# Firebase service-account credentials — never committed
*firebase-adminsdk*.json
service-account*.json

# IDE device selection records the physical device serial — local only
.idea/deploymentTargetSelector.xml

# Packaged app artifacts (build outputs are ignored above; this catches strays)
*.apk
*.aab
*.pfx
