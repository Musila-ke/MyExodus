<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".blocking.DeviceVerificationActivity"
            android:exported="true" />
        <activity
            android:name=".vpn.VpnSpikeActivity"
            android:exported="true" />
        <activity
            android:name=".accountability.PairingTestActivity"
            android:exported="true" />
