<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Block close (user ruling 2026-09-27: "logically just block the app and close it"):
        eviction to Home alone left a blocked app running in the background, still audible
        (device-caught: Instagram playing under the wall). killBackgroundProcesses is the
        strongest close a third-party app can perform; normal permission, granted at install. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Full-tunnel VpnService (plan §8.4): the TUN socket is created by the system and
        only readable by us; INTERNET is needed for the protect()-ed upstream sockets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission (no runtime prompt): queried by BiometricManager.canAuthenticate
        (§8.2 enrollment polling); declared up-front per the platform contract. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <!-- App-block detection (plan §8.1): a special-access appop, not a runtime prompt —
        the user grants it from Settings > Usage access (deep link: ACTION_USAGE_ACCESS_SETTINGS). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- §8.1 FGS with type specialUse (API 34+); FOREGROUND_SERVICE_SPECIAL_USE is
        required alongside the service's PROPERTY_SPECIAL_USE_FGS_SUBTYPE justification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Transsion XOS exception (plan §8 Step 5, 2026-08-27): XOS cannot show
        TYPE_ACCESSIBILITY_OVERLAY, so on Transsion the blocking overlay is
        TYPE_APPLICATION_OVERLAY, which requires this appop ("display over other apps").
        Declaring it also makes the app appear in XOS's overlay-permission list. Stock
        Android never uses it (the a11y overlay needs no permission); it is an appop, not
        a runtime prompt. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- §8.7/D1 battery-prompt leg: powers ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, and
        only from the Settings row the outage prompt unlocks (§8.2's "verify the channel is
        permitted" resolves to yes — direct-APK distribution, no Play listing, so Play's
        acceptable-use table does not gate this app; ruling recorded in
        BatteryPromptGate.DIRECT_REQUEST_PERMITTED). Never requested at first launch. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- ADR #171 self-update: PackageInstaller sessions for the GitHub Releases channel.
        Direct-APK distribution (ADR #15): the installer still gates each install behind the
        per-app "install unknown apps" grant (canRequestPackageInstalls). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Update plan v1.1 §8.5: conditional unattended self-update on API 31+. Android still
        applies its own target-SDK/installer eligibility checks and may return a normal user
        prompt instead; it is never treated as guaranteed. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- App picker (Rules screen): needed on API 30+ for queryIntentActivities on
        launcher apps and for the app-label lookup on the picked package. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic=false: on API 26-27 the platform default is true, so the release
        build said "cleartext allowed" without meaning to; the only app HTTP client (updater)
        already rejects non-HTTPS. Debug overrides it for the local HTTP QA rig. -->
    <application
        android:name=".MyExodusApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyExodus">
        <!-- launchMode=singleTop: the shell is the app's root activity and must receive every
            deep link (notification taps, widget, block-screen escape hatch) through
            onNewIntent — with standard mode a launch to an existing task is delivered only as
            a task-bring-to-front on some OEMs (XOS verified), silently dropping the extras.
            Portrait lock on this activity and the two full-screen surfaces below (block wall,
            widget action) is a deliberate product choice; Android 16 ignores it on large
            screens. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyExodus"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <!-- configChanges (the androidx Compose template set) keeps in-flight session state
                alive: recreation reset the delay timer and the pacer, and made the recovery
                session log an ABANDONED row plus a fresh row on every rotation (rotation
                reproduced on the X6532, 2026-09-19 — the rule editor's plain-remember banner
                vanished while its saveable text survived, proving the Activity was destroyed).
                A genuine recreation (process death) is still covered: the app-start sweep
                relabels stale STARTED rows INTERRUPTED, and the tint controls re-read prefs. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager on-demand init (MyExodusApp is a Configuration.Provider so the Hilt
            worker factory applies); the default androidx.startup initializer would bypass it. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <receiver
            android:name=".blocking.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Direct-APK updates (install -r) kill the process; nothing re-armed the FGS
                     afterward and protection stayed down until the app was next opened
                     (X6532-observed 2026-09-28). MY_PACKAGE_REPLACED re-arms it like a boot. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Partner delivery plan §4.1: BOOT_COMPLETED after first unlock reconciles the
             event queue; ordinary (non-direct-boot) work is unreachable before USER_UNLOCKED. -->
        <receiver
            android:name=".accountability.delivery.PartnerEventBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Notification actions for the degraded-protection alert (§8.2 explicit
            re-enable). Component-explicit intents only; never exported to other apps. -->
        <receiver
            android:name=".blocking.ProtectionActionReceiver"
            android:exported="false" />

        <!-- Habit-streaks §8 Step 4: milestone alarms do not survive reboot, so every boot
            re-derives the pending alarm set from durable state. Post-unlock broadcast only —
            the rules store is credential-encrypted and unreachable pre-unlock. -->
        <receiver
            android:name=".streaks.MilestoneBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Milestone alarm firing (§6/§8 Step 4). Component-explicit; never exported. -->
        <receiver
            android:name=".streaks.MilestoneAlarmReceiver"
            android:exported="false" />

        <!-- Update plan v1.1 §8.5: explicit non-exported PackageInstaller status callback,
            correlated to the owned attempt/session. It never launches UI from the background;
            a pending user action is presented from a resumed activity or a user tap. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Update plan v1.1 §8.6: reconcile the owned attempt against the installed version
            after package replacement. Non-blocking; no foreground service starts here. -->
        <receiver
            android:name=".update.UpdatePackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Plan revision 2026-11-06: DownloadManager's completion broadcast is the only
            wake-up for a finished transfer; verification runs in an expedited worker. -->
        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Partner Pillar v2 plan §8 Step 7 (client FCM transport): receives the relay's
            data-only wake signal (AD-11 — generic messageId + type, never content) and
            enqueues the partner-sync pass. exported=false: FCM delivers via the app's own
            process through Google Play services, not through a public component. -->
        <service
            android:name=".accountability.sync.PartnerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- §8.1 app-block detection + enforcement plan v2 §8 Step 5 daily-usage-limit
            enforcement, one always-on service (folded 2026-09-15 per user ruling). specialUse
            requires the subtype property on API 34+; the declaration is part of the
            Play-policy self-check (§12) when the release build is prepared. START_STICKY
            restarts after a crash, which is exactly the §8.1 recompute-from-current-state
            startup path. -->
        <service
            android:name=".blocking.EnforcementForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_blocking_and_daily_usage_limit_enforcement" />
        </service>

        <!-- The app-block screen (plan §8.1 Decision 3): a real Activity so Back cannot be
            dismissed into the target app and FLAG_HIDE_NON_SYSTEM_OVERLAY_WINDOWS cannot
            suppress it. Own task affinity (never stacks on app UI) + excluded from recents;
            the predictive-back opt-in routes the gesture into the activity's no-op callback. -->
        <activity
            android:name=".blocking.BlockerActivity"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MyExodus.Blocker"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:taskAffinity="" />

        <!-- Plan §8.5: fires pre-unlock so enforcement data (DE snapshot copy) is published
            before Room is reachable. directBootAware is required to receive it. -->
        <receiver
            android:name=".blocking.LockedBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Slice 3 VPN PoC (plan §7 step 3): the system binds this via the
            android.net.VpnService intent-filter (exported contract per official docs);
            BIND_VPN_SERVICE restricts the binder to the system. SUPPORTS_ALWAYS_ON=false:
            the always-on "block connections without VPN" mode can brick connectivity
            (plan §8.4) — the spike stays explicitly opt-in per-launch. -->
        <service
            android:name=".vpn.DnsSinkholeVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>

        <!-- Home-screen widget (V1 Req 36), widget spec §7 Steps 4/7. exported=true is required,
            not a weakening: the launcher's AppWidgetHost broadcasts APPWIDGET_UPDATE from another
            process/UID and would be blocked otherwise (§10). updatePeriodMillis=0 in the provider
            info — the app drives every refresh itself. -->
        <receiver
            android:name=".widget.DesertDawnWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/desert_dawn_widget_info" />
        </receiver>

        <!-- Widget v2 (owner spec 2026-10-15): the action pills' hold-to-confirm surface. Own
             task affinity (never stacks on the launcher or on app UI), out of recents.
             exported=false: only ever started by the widget's own PendingIntent, which executes
             with this app's identity. singleTop: a second pill tap delivers through onNewIntent
             instead of stacking. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:taskAffinity="com.example.myexodus.widgetsurface"
            android:theme="@style/Theme.MyExodus.WidgetAction" />

        <!-- isAccessibilityTool=false (enforcement plan v2 §8 Step 4): this service enforces
            user-configured restrictions, it does not assist accessibility — the flag keeps
            the service visible in accessibility settings as a restriction tool. -->
        <service
            android:name=".blocking.BlockerAccessibilityService"
            android:exported="false"
            android:label="@string/enhanced_mode_service_label"
            android:isAccessibilityTool="false"
            tools:targetApi="31"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>