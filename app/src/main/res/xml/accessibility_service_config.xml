<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced Mode spec §8 Step 4: exactly these event types, no notification timeout.
     flagRetrieveInteractiveWindows-as-boolean-attr removed from compileSdk 37 stubs; the
     bitmask form (accessibilityFlags) is the functional equivalent. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="true"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:description="@string/enhanced_mode_accessibility_description" />
