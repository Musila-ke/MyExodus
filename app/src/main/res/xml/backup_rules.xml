<?xml version="1.0" encoding="utf-8"?><!--
   Pre-API-31 full-backup rules. allowBackup="false" already disables cloud/ADB backup
   entirely on every version; these exclusions mirror data_extraction_rules.xml as
   belt-and-braces (habit-streaks plan §10 / Decision 14).
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="rules_snapshot.json" />
    <!-- Widget snapshot (widget spec §10): Preferences DataStore lives in files/datastore/.
         Device-local protection state — the boot count in it is meaningless elsewhere. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
