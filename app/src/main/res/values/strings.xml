    <string name="setup_usage_title">Usage access</string>
    <string name="setup_usage_body">MyExodus uses this to tell which app is in front. Without it, app blocking can’t run.</string>
    <string name="setup_usage_action">Open Usage Access settings</string>
    <string name="setup_disclosure_title">What MyExodus sees</string>
    <string name="setup_disclosure_body">To block apps and sites, MyExodus checks the name of the app you switch to — and, in supported browsers only, the address-bar text. App names and usage times stay on this device.</string>
    <string name="setup_disclosure_action">Continue</string>
    <string name="setup_accessibility_title">Accessibility service</string>
    <string name="setup_accessibility_body">Detects when you open an app or website on your list and shows the block screen right away. Without it, blocks still work — they just start up to a few seconds later while detection falls back to polling.</string>
    <string name="setup_accessibility_action">Open Accessibility settings</string>
    <string name="setup_notifications_title">Notifications</string>
    <string name="setup_notifications_body">Used only for a warning before a daily limit runs out and for protection alerts. Blocking works without it — you just won’t get a heads-up.</string>
    <string name="setup_notifications_action">Allow notifications</string>
    <string name="setup_notifications_action_settings">Open notification settings</string>
    <string name="setup_overlay_title">Display over other apps</string>
    <string name="setup_overlay_body">Lets MyExodus show the block screen on top of a blocked app, including the fallback used when Accessibility is off. Without it, that fallback can’t block or warn.</string>
    <string name="setup_overlay_action">Open Display over other apps settings</string>

    <!-- Home-screen widget (V1 Req 36). Every string here is discreet by default: a day count,
         and only if the user opts in, one status word. No recovery vocabulary is reachable in
         discreet mode (widget spec FR5). "Manage urge" is the app's own term for the Recovery
         tab's entry point, so the widget reuses it rather than inventing a second name. -->
    <string name="widget_label">Streak</string>
    <string name="widget_description">Your day count at a glance.</string>
    <string name="widget_day_count">Day %1$d</string>
    <string name="widget_day_unknown">No streak yet</string>
    <string name="widget_manage_urge">Manage urge</string>
    <string name="widget_status_protected">Protected</string>
    <string name="widget_status_unprotected">Not protected</string>
    <string name="widget_status_unverified">Unverified</string>
    <!-- Partner dashboard (plan §7 item 12 / FR3): the paired device's last-known shared
         state. Copy never promises real-time delivery (AD-05 best-effort cadence) and keeps
         the §9 chain states distinct — "some history missing" is neutral; the unverified
         state blocks trust and names re-pairing as the fix, without claiming it is automatic. -->
    <string name="partner_title">Partner</string>
    <string name="partner_subtitle">Shared from the phone you’re paired with</string>
    <string name="partner_loading">Loading saved partner state…</string>
    <string name="partner_unpaired_title">No partner yet</string>
    <string name="partner_unpaired_body">After you pair with an accountability partner, the activity their phone shares shows up here.</string>
    <!-- Step 17 (AD-22): forced re-enrollment — the pair data was lost locally, recovery is
         deliberately not attempted, and the only route forward is pairing again. -->
    <string name="partner_wipe_title">Pairing data was lost</string>
    <string name="partner_wipe_body">This phone’s pairing data went missing, so the connection to your partner was cleared and can’t be restored automatically. Pair again with a new code to reconnect. Until then, nothing is shared.</string>
    <string name="partner_paired_with">Paired with %1$s</string>
    <string name="partner_paired_since">Since %1$s</string>
    <string name="partner_paired_explainer">That code identifies your partner’s device — they see the same code for you, so you can both confirm you paired with the right person.</string>
    <string name="partner_never_synced">Never synced yet</string>
    <string name="partner_last_synced">Last synced %1$s</string>
    <string name="partner_sync_delayed">Sync is taking longer than usual — the phone may be offline or paused by Android.</string>
    <string name="partner_sync_note">Updates arrive when both phones are online. There is no instant delivery.</string>
    <string name="partner_sync_rate_limited">Some recent updates came in faster than the server allows, so they weren’t sent as instant alerts. They’ll arrive with the next sync.</string>
