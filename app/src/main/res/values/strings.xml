    <!-- Step 14 unpair (§8 Step 13 copy — AD-13b: local is guaranteed, remote is best-effort
         and only ever claimed from the partner device's own confirmation). -->
    <string name="partner_unpair_title">End partnership</string>
    <string name="partner_unpair_body">This erases your partner’s data on this device immediately. Your partner’s phone erases its own copy next time it’s online — that part can’t be forced.</string>
