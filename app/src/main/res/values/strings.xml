    <string name="setup_disclosure_title">What MyExodus sees</string>
    <string name="setup_disclosure_body">To block apps and sites, MyExodus checks the name of the app you switch to — and, in supported browsers only, the address-bar text. App names and usage times stay on this device.</string>
