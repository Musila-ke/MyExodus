<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window background = Desert Dawn SandLight (audit finding #15): the window shows before the
         first Compose frame and behind edge-to-edge insets, and the Material default is a cold
         near-white that flashes against the brand surface on every cold start. The dark variant
         lives in values-night/themes.xml; keep both in step with ui/theme/Color.kt. -->
    <style name="Theme.MyExodus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Owner report 2026-11-01: the block wall slid in from the right over 273 ms, leaving the
         blocked app visible during the transition — it read as a mis-sized wall. The a11y
         overlay host already appears instantly; this makes the Activity host match. -->
    <style name="Theme.MyExodus.Blocker" parent="Theme.MyExodus">
        <item name="android:windowAnimationStyle">@style/Animation.MyExodus.None</item>
    </style>
    <style name="Animation.MyExodus.None" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <!-- Widget v2 (owner spec 2026-10-15): the pills' hold-to-confirm surface is a sheet over
         the launcher — translucent window, no background of its own, and the system dims what
         is behind it so the card reads as modal. -->
    <style name="Theme.MyExodus.WidgetAction" parent="Theme.MyExodus">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
