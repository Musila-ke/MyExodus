{
  "name": "myexodus-functions",
  "private": true,
  "description": "Partner Pillar v2 Cloud Functions \u2014 pairing registration, push relay, retry sweep, rate limits (plan \u00a78 Steps 3/5/6/18).",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test",
    "test:sos": "firebase emulators:exec --only firestore --project demo-myexodus-sos \"node --test emulator-test/partner-sos.emulator.js emulator-test/partner-sos-push.emulator.js emulator-test/partner-sos-scheduler.emulator.js\"",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-myexodus-step2 \"node --test emulator-test/firestore-rules.emulator.js\"",
    "test:append": "firebase emulators:exec --only firestore --project demo-myexodus-append \"node --test emulator-test/event-append.emulator.js\"",
    "test:lifecycle": "firebase emulators:exec --only firestore --project demo-myexodus-lifecycle \"node --test emulator-test/pair-lifecycle.emulator.js\"",
    "test:heartbeat": "firebase emulators:exec --only firestore --project demo-myexodus-heartbeat \"node --test emulator-test/heartbeat.emulator.js\"",
    "test:dms": "firebase emulators:exec --only firestore --project demo-myexodus-dms \"node --test emulator-test/dms.emulator.js\"",
    "test:liveness": "firebase emulators:exec --only firestore --project demo-myexodus-device-contact \"node --test emulator-test/device-contact.emulator.js\"",
    "test:dms-soak": "firebase emulators:exec --only firestore --project demo-myexodus-dms-soak \"node emulator-test/dms-soak.js\"",
    "test:transition": "firebase emulators:exec --only firestore --project demo-myexodus-transition \"node --test emulator-test/guest-transition.emulator.js\"",
    "test:backup-key": "firebase emulators:exec --only firestore --project demo-myexodus-backup-key \"node --test emulator-test/backup-key.emulator.js\"",
    "test:backup-upload": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-myexodus-backup-upload \"node --test emulator-test/backup-manifest.emulator.js\"",
    "test:storage-rules": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-myexodus-backup-rules \"node --test emulator-test/storage-rules.emulator.js\"",
    "test:deletion": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-myexodus-deletion \"node --test emulator-test/account-deletion.emulator.js\"",
    "test:partner-registration": "firebase emulators:exec --only firestore --project demo-myexodus-partner-registration \"node --test emulator-test/partner-registration.emulator.js\"",
    "test:partner-ingest": "firebase emulators:exec --only firestore --project demo-myexodus-partner-ingest \"node --test emulator-test/partner-ingest.emulator.js\""
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
