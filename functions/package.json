{
  "name": "myexodus-functions",
  "private": true,
  "description": "Partner Pillar v2 Cloud Functions \u2014 pairing registration, push relay, retry sweep, rate limits (plan \u00a78 Steps 3/5/6/18).",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test",
    "test:sos": "firebase emulators:exec --only firestore --project demo-myexodus-sos \"node --test emulator-test/partner-sos.emulator.js emulator-test/partner-sos-push.emulator.js emulator-test/partner-sos-scheduler.emulator.js\"",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-myexodus-step2 \"node --test emulator-test/firestore-rules.emulator.js\""
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
