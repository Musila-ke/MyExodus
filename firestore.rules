rules_version = '2';
// Partner Pillar v2 Firestore rules (plan §8 Step 1 / AD-02, AD-18a/b, AD-19, AD-23).
// Supersedes the v1 accountability-protocol rules (pairs / accountability_events /
// backfill_requests / pairing_tokens / deleted_pairs): no production pairs exist (no
// pairing UI has shipped), so there is no data to migrate — the v2 document layout is
// adopted wholesale. Deployment (CLI/Console) is a separate user step; the rules-emulator
// suite is plan §12.
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-side pairing record. Written ONLY by the registerPairing Cloud Function
    // (admin SDK bypasses rules), which requires matching signed transcript hashes from
    // both devices (plan §8 Step 3 / AD-02). Client writes are denied outright — which
    // also structurally removes the v1 revocation-reopen gap, since a client can no
    // longer create or re-create a pairing document.
    // Read: `resource == null` is a rule error (denial), not a false — clients must treat
    // PERMISSION_DENIED on this read as "not yet registered" (same trap the v1 rules
    // documented, caught on-device 2026-08-30). Do not add a null-permitting branch: that
    // would let any authenticated user probe whether two known uids are paired.
    //
    // Amendment (plan §8 Step 13 / AD-13b, superseded by account plan Release 0 step 3):
    // revocation moved behind the `terminatePair` callable, which validates membership and
    // writes the deterministic `system_events/pair_terminated` record. Clients can no longer
    // write this document at all — create/update/delete are denied, so the v1
    // revocation-reopen gap stays structurally closed and pair membership/status can never
    // be tampered with client-side. The losing racer in a mutual unpair is an idempotent
    // success inside the callable.
    match /pairings/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;

      // Backend-originated lifecycle events only (account plan §4.3/§8.2). Participants may
      // read; Admin SDK is the only writer (`terminatePair` writes pair_terminated). These
      // are server-authenticated metadata events, never E2EE peer content.
      match /system_events/{eventId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/pairings/$(pairId))
          && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairId)).data.members;
        allow create, update, delete: if false;
      }
    }

    // Mailbox = the shipped event_chain (account plan §4.3 adapter): immutable, append-only
    // E2EE events. Since Release 0 step 2 every append goes through the `appendUserEvent`
    // callable (Admin SDK), so DIRECT CLIENT CREATE IS DENIED — the outer-schema allowlist,
    // record kind, size cap, pair/profile state and operator kill switch all live server-side
    // (`event-append.js`). Old clients that still write directly fail closed and must update
    // (plan step 5). Reads and acks keep their shipped shape.
    match /mailboxes/{recipientUid}/messages/{messageId} {
      // Read: the recipient (owner) as before, plus the message's AUTHOR — the relay marks a
      // rejected message with `relayStatus` on this document, and that marker is the send
      // failure the author's client must be able to observe distinctly (§8 Step 18, §9:
      // RATE_LIMITED is not a network failure). The author already wrote every field here
      // (content, ciphertext, pairId); only "was it relayed" is newly visible. Same
      // author-read shape as the ack rule below.
      allow read: if request.auth.uid == recipientUid
        || resource.data.senderUid == request.auth.uid;
      // Append is callable-only (Release 0 step 2/3). Immutable after create; deletion is
      // exclusively the scheduled cleanup function's job (AD-18b). A client must never be
      // able to create, update or delete a mailbox document.
      allow create, update, delete: if false;

      // Per-installation acknowledgment (AD-18b), written by the recipient device itself
      // after it has processed the event. The cleanup function deletes a message only
      // once every registered installation has an ack (or the 30-day cap is reached).
      //
      // Read: the recipient (owner) as before, plus the message's AUTHOR — the AD-13b
      // remote-erasure evidence is the initiator reading the ack on the deletion request it
      // wrote. exists() guards the get() so a cleaned-up message is a plain denial, never a
      // rule error. The author already knows the message content; only "was it processed"
      // is newly visible, which is exactly the evidence AD-13b defines.
      match /acks/{installationId} {
        allow read: if request.auth.uid == recipientUid
          || (exists(/databases/$(database)/documents/mailboxes/$(recipientUid)/messages/$(messageId))
              && get(/databases/$(database)/documents/mailboxes/$(recipientUid)/messages/$(messageId)).data.senderUid == request.auth.uid);
        allow create: if request.auth.uid == recipientUid
          && request.resource.data.keys().hasOnly(['ackedAt'])
          && request.resource.data.ackedAt == request.time;
        allow update, delete: if false;
      }
    }

    // Partner SOS — Reach Out nudge (V1 Req 35, plan §8.2). Nudge documents are written
    // exclusively by the sendNudge callable (Admin SDK bypasses rules); the recipient device
    // is the only client reader, and its one write is the acknowledgment. The read carries
    // the pair-active gate through the same exists+get pattern as the mailbox create rule.
    //
    // get vs list are split deliberately. get (direct read by id after a notification tap)
    // carries the plan §8.2 expiresAt gate: TTL may lag its cleanup by ~24h, and a direct
    // read of a dead record is refused. list (the Home §6.9 query) cannot carry it: the
    // rules engine evaluates a LIST against the query's potential result set, and a
    // request.time comparison on a field the query does not constrain is unevaluable
    // ("Property expiresAt is undefined on object" — verified against the emulator,
    // rules-test R-F2q). The plan scopes the gate to direct reads (§8.2) and puts expiry
    // filtering on the client query (§6.9 / §17: "Client queries apply the expiresAt
    // check"). The list side therefore re-checks exactly what the engine can prove from
    // the §6.9 query constraints: recipient identity and a live pair.
    match /pairings/{pairId}/nudges/{nudgeId} {
      allow get: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && exists(/databases/$(database)/documents/pairings/$(pairId))
        && get(/databases/$(database)/documents/pairings/$(pairId)).data.status == 'active'
        && resource.data.expiresAt >= request.time;
      allow list: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && exists(/databases/$(database)/documents/pairings/$(pairId))
        && get(/databases/$(database)/documents/pairings/$(pairId)).data.status == 'active';
      // Acknowledgment: the recipient flips ackedAt exactly once. get() treats an absent
      // field as null, so the gate holds for both the schema's explicit null and a
      // pre-schema document; the diff() hasOnly makes every other field immutable.
      allow update: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && resource.data.get('ackedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackedAt'])
        && request.resource.data.ackedAt == request.time;
      allow create, delete: if false;
    }

    // Nudge rate-limit state (per pairId × senderUid): the sendNudge callable's sole
    // bookkeeping. Function-only in both directions.
    match /pairings/{pairId}/nudgeState/{senderUid} {
      allow read, write: if false;
    }

    // Nudge block preference (owner-owned, plan §8.2): read/write only by the owner while
    // the pair is active and the owner is a member (same membership boundary as the
    // mailbox create rule). Only `blocked` + `updatedAt` exist, boolean + server time.
    match /pairings/{pairId}/nudgeSettings/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/pairings/$(pairId))
        && get(/databases/$(database)/documents/pairings/$(pairId)).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairId)).data.members;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/pairings/$(pairId))
        && get(/databases/$(database)/documents/pairings/$(pairId)).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairId)).data.members
        && request.resource.data.keys().hasOnly(['blocked', 'updatedAt'])
        && request.resource.data.blocked is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // User profile (account plan §4.3/§8.2): owner read only. Created and mutated solely by
    // `initializeUserProfile` and future lifecycle callables (Admin SDK); clients never
    // write it. This match is document-level — subcollections keep their own rules below.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Per-device/provider push registrations (AD-18a). provider is constrained to the
    // transports that exist (plan §8 Steps 7/8); token freshness is tracked via updatedAt.
    // pushEligible (SOS §8.12) is optional so pre-SOS clients keep registering; when present
    // it is a capability snapshot, never authority.
    match /users/{uid}/push_installations/{installationId} {
      allow read: if request.auth.uid == uid;
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['provider', 'token', 'platform', 'appVersion', 'pushEligible', 'updatedAt', 'createdAt'])
        && request.resource.data.provider in ['fcm', 'hms']
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform is string
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32
        && (!request.resource.data.keys().hasAny(['pushEligible'])
            || request.resource.data.pushEligible is bool)
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth.uid == uid;
    }

    // Pairing rendezvous (user-ruled 2026-09-18: the SAS/QR public-key exchange stays as
    // shipped — the pairing QR cannot carry the initiator's attestation payload, device-
    // caught 2026-08-30). Document id = SHA-256(token), so possession of the 256-bit token
    // is the read capability; lifetime is enforced against request.time. Release 0 step 2
    // moved minting and the partner response behind `createPairInvitation` /
    // `respondToPairInvitation` (Admin SDK validates expiry, single-use, self-response,
    // profile state and per-UID rate limits), so client create/update are now denied. Read
    // and delete stay client-side: the token holder reads the rendezvous material and
    // removes the document after registerPairing activates the pair. This document is
    // transport only — authority is the signed proof registered through the function.
    match /pairing_tokens/{tokenId} {
      allow create, update: if false;
      allow read: if request.auth != null
        && (resource == null || resource.data.expiresAt > request.time);
      allow delete: if request.auth != null
        && (resource == null || resource.data.expiresAt > request.time);
    }

    // Client compatibility metadata (account plan §4.3, Release 0 step 4): server-published,
    // public read so an outdated client can learn it must update; never client-writable.
    match /clientCompatibility/{docId} {
      allow read: if docId == 'current';
      allow write: if false;
    }

    // Release 0 server-owned collections (account plan §4.3/§8.2): deletion tombstones/job
    // state and event token buckets are Admin SDK only in both directions.
    match /deletionJobs/{document=**} { allow read, write: if false; }
    match /eventRateLimits/{document=**} { allow read, write: if false; }

    // Relay bookkeeping + rate counters + pairing idempotency records: function-only
    // (AD-10, AD-23, §9 corrected ordering).
    match /relay-dispatch/{document=**} { allow read, write: if false; }
    match /rate-limits/{document=**} { allow read, write: if false; }
    match /idempotency/{document=**} { allow read, write: if false; }

    // Device-availability state (partner event-delivery plan §7 Step 7/§8.10-§8.11):
    // written only by the submitHeartbeat callable and read only by the DMS deadline
    // processor. A client never reads its own liveness row directly — the partner-facing
    // status comes from the read-at-time derivation (§8.10), never a precise timestamp.
    match /dms_install_state/{document=**} { allow read, write: if false; }

    // DMS Step 8 (§8.11): the durable notification outbox, the operator-recorded ingestion-
    // outage intervals, and the processor's deployment config are Admin SDK only. Consent
    // itself lives on the authoritative pairing document and is written by the
    // setAvailabilityConsent callable — there is no client-writable DMS surface at all.
    match /dms_notification_outbox/{document=**} { allow read, write: if false; }
    match /dms_ingestion_outages/{document=**} { allow read, write: if false; }

    // SOS push queue + feature flag: Admin SDK only (plan §8.2/§8.4). Default-deny would
    // cover both, but the explicit lines keep the function-only surface auditable in one
    // place, same as the v1 relay collections above.
    match /nudgePushQueue/{document=**} { allow read, write: if false; }
    match /config/features { allow read, write: if false; }
    match /config/dms { allow read, write: if false; }

    // Guest transition (account plan §4.2/§8.4): records hold the capability hash and the
    // lease enforces one unfinalized transition per guest uid — both are function-only, and
    // the capability itself must never be client-readable anywhere. The gate document is
    // likewise server-owned so a client can neither read nor flip the flag.
    match /guestTransitions/{document=**} { allow read, write: if false; }
    match /guestTransitionLeases/{document=**} { allow read, write: if false; }
    match /serverFeatureGates/{document=**} { allow read, write: if false; }

    // Encrypted backup state (account plan §4.3, Release 2): the key bundle, the pointer and
    // the committed manifests are owner-readable only while the account is active, and only
    // the backup callables (Admin SDK) ever write them. The get() on an absent profile is a
    // rule error, i.e. a denial — a UID with no profile has nothing to read.
    match /users/{uid}/backupControl/{docId} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'ACTIVE';
      allow write: if false;
    }
    match /users/{uid}/backupManifests/{backupId} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'ACTIVE';
      allow write: if false;
    }
    // Upload reservations are server-only in both directions (Storage rules consult them
    // through the Admin path, never a client session).
    match /backupReservations/{document=**} { allow read, write: if false; }
  }
}
